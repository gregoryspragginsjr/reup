{% block html_head_container %}

{% include 'html-header.twig' %}
  {% block head %}
  {% endblock %}
  </head>
{% endblock %}

  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NL47ZZB"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) --> 

    <div id="app">
      {% if fn('is_post_type_archive', 'resources') %}
        {% set breadcrumbs_type = fn('get_query_var', 'audience') %}
      {% elseif fn('is_category') %}
        {% set breadcrumbs_type = null %}
      {% else %}
        {% set breadcrumbs_type = post.terms('audiences')|length == 1 ? post.terms('audiences')[0].slug : null %}
      {% endif %}
      {% include 'header.twig' with {
        type: breadcrumbs_type,
        breadcrumbs: fn('is_front_page') ? null : breadcrumbs_menu,
        primary: [
          {
            url: '/whats-included/',
            title: "What's Included",
            children: [
              {
                url: '/whats-included/outreach-and-re-engagement/',
                title: 'Outreach and Re-Engagement',
                excerpt: 'Reconnection that works'
              },
              {
                url: '/whats-included/intelligence/',
                title: 'Intellegence',
                excerpt: 'Data that acts'
              },
              {
                url: '/whats-included/technology/',
                title: 'Technology',
                excerpt: 'Built for one goal'
              },
              {
                url: '/whats-included/coaching-and-learner-support/',
                title: 'Coaching & Learner Support',
                excerpt: 'Support that shows up'
              },
            ],
          },
          {
            url: '/who-can-benefit/',
            title: 'Who Can Benefit',
            children: [
              {
                url: '/who-can-benefit/states',
                title: 'Grow your workforce',
                tag: 'States',
              },
              {
                url: '/who-can-benefit/institutions/',
                title: 'Re-enroll stop outs',
                tag: 'Institutions',
              },
              {
                url: '/who-can-benefit/learners/',
                title: 'Complete your degree',
                tag: 'Learners',
              },
            ],
          },
          {
            url: '/resources/',
            title: 'Resources',
            children: [
              {
                url: '/resources/?audience=states',
                title: 'Resources',
                tag: 'States',
              },
              {
                url: '/resources/?audience=institutions',
                title: 'Resources',
                tag: 'Institutions',
              },
              {
                url: '/resources/?audience=learners',
                title: 'Resources',
                tag: 'Learners',
              },
            ],
          },
          {
            url: '/company',
            title: 'Company',
            children: [
              {
                url: '/company/our-team',
                title: 'Leadership Team',
              },
              {
                url: '/company/careers',
                title: 'Careers',
              },
              {
                url: '/category/press/',
                title: 'Press',
              },
            ],
          },
        ],
        utility: [
          {
            url: '/',
            title: 'Drive growth',
            tag: 'States',
          },
          {
            url: '/',
            title: 'Get insights',
            tag: 'Institutions',
          },
          {
            url: '/',
            title: 'Meet coach',
            tag: 'Learners',
          },
          {
            url: '/',
            title: "Let's chat",
            tag: 'Anybody',
          },
        ],
      } %}
      <main id="main" class="page">
        {% block content %}
          Sorry, no content
        {% endblock %}
      </main>
      {% include 'footer.twig' with {
        primary: footer_menu.items,
        copyright: copyright_menu.items,
        address: global_address
      } %}
      {% block footer %}
        {{ function('wp_footer') }}
      {% endblock %}
    </div>
  </body>
</html>
