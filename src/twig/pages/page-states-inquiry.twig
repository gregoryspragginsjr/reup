{% extends "no-vue.twig" %}

{% block content %}
  <div class="page wysiwyg">
	  {{ post.content }}

    <div class="page__form">
      <div class="page__inner grid">
        <div class="page__secondary">
          {% include 'context.twig' with {
            size: size|default('large'),
            tags: [
              'states'
            ],
            heading: 'A coordinated approach to re-engaging your state’s adult learners.',
            paragraphs: '<p>Tell us what’s top of mind for your state, and let’s explore what’s possible together.</p>',
          } %}
        </div>
        <div class="page__secondary">
          <div class="hbspt-form__label  hbspt-form__label--special"><span class="hs-form-required">*</span> Mandatory Field</div>
          <script charset="utf-8" type="text/javascript" src="//js.hsforms.net/forms/embed/v2.js"></script>
          <script>
            hbspt.forms.create({
              portalId: "4734338",
              formId: "18ab98ef-0d55-477d-a411-24762f8b22c7",
              region: "na1"
            });
          </script>
        </div>
      </div>
    </div>
  </div>
{% endblock %}
